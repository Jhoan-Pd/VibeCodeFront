# ===== Backend (VibeDecoder API, ConnectRPC) =====
# URL the Next server uses (Server Components, Auth.js). Local: http://localhost:4000
BACKEND_URL="http://localhost:4000"
# URL the browser uses (it calls the backend directly; the backend must list this site in ALLOWED_ORIGINS).
NEXT_PUBLIC_BACKEND_URL="http://localhost:4000"
# Shared HS256 secret: THE SAME value as BACKEND_JWT_SECRET on the backend. At least 32 characters.
# Generate one with: openssl rand -base64 48
BACKEND_JWT_SECRET=""

# ===== Auth.js =====
# Generate one with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# GitHub OAuth App (Settings > Developer settings > OAuth Apps)
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""
# Google OAuth client (console.cloud.google.com → Credentials → OAuth client ID, "Web application").
# Redirect URIs: http://localhost:3000/api/auth/callback/google and https://YOUR-APP.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ===== Limits shown in the UI (the backend enforces the real ones) =====
# Maximum code size in characters (the backend's MAX_CODE_CHARS)
NEXT_PUBLIC_MAX_CODE_CHARS="20000"
# New analyses per day (the backend's DAILY_ANALYSIS_LIMIT)
NEXT_PUBLIC_DAILY_ANALYSIS_LIMIT="10"
