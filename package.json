{
  "name": "vibedecoder-frontend",
  "version": "2.0.0",
  "private": true,
  "description": "VibeDecoder web app (Next.js): explains AI-generated code line by line, with diagrams, audit, quiz and chat. Talks to the backend over ConnectRPC.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate": "buf generate",
    "proto:sync": "node scripts/sync-proto.mjs",
    "postinstall": "node scripts/copy-monaco.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.2.0",
    "@connectrpc/connect-web": "2.2.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@monaco-editor/react": "4.7.0",
    "@radix-ui/react-slot": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "6.2.12",
    "lucide-react": "^0.468.0",
    "mermaid": "^11.4.0",
    "monaco-editor": "^0.52.0",
    "next": "15.5.27",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^2.5.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.73.0",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "^5.7.2",
    "vitest": "^3.2.0"
  }
